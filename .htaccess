# Myzel-Schach – Auslieferung des fertigen Builds (Apache hinter nginx, Plesk)
AddType application/wasm .wasm
AddType text/javascript .js .mjs
AddType font/woff .woff
<IfModule mod_headers.c>
  # gehashte Build-Dateien dürfen lange gecacht werden, index.html nicht
  <FilesMatch "\.(js|css|woff|wasm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
# Interne Dateien nicht ausliefern
<FilesMatch "^(DEPLOY\.md)$">
  Require all denied
</FilesMatch>
# Offline-Rätselpaket ist bereits gzip-komprimiert (wird im Browser entpackt) und version.json nie cachen
AddType application/gzip .gz
<IfModule mod_headers.c>
  <FilesMatch "version\.json$">
    Header set Cache-Control "no-store"
  </FilesMatch>
</IfModule>
